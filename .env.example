# Supabase — get these from your project: Settings → API
# Both are safe to expose to the browser (the anon key is public).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Google OAuth is configured in the Supabase dashboard
# (Authentication → Providers → Google), NOT here. Paste your
# Google client ID + secret there. See docs/research/naano/app/AUTH_SETUP.md
